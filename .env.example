# ==================================================================
# .env.example — шаблон переменных окружения
# Скопируй в .env.local и заполни значения.
# .env.local в .gitignore и НЕ должен попадать в репозиторий.
# ==================================================================

# ---------- Supabase ----------
# Создаётся в Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только серверный код — никогда не использовать в Client Components
SUPABASE_SERVICE_ROLE_KEY=

# ---------- ЮKassa (платежи) ----------
# Регистрация: https://yookassa.ru/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- CloudPayments (резервный платёжный шлюз) ----------
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ---------- Kinescope (видеохостинг) ----------
KINESCOPE_API_TOKEN=
KINESCOPE_PROJECT_ID=

# ---------- Unisender (email) ----------
UNISENDER_API_KEY=
UNISENDER_FROM_EMAIL=noreply@your-domain.ru
UNISENDER_FROM_NAME="VideoEdit Academy"

# ---------- Yandex OAuth ----------
# Создаётся: https://oauth.yandex.ru/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# ---------- VK OAuth ----------
# Создаётся: https://id.vk.com/about/business/go
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=

# ---------- Yandex SmartCaptcha ----------
# Создаётся: https://cloud.yandex.ru/services/smartcaptcha
NEXT_PUBLIC_YANDEX_CAPTCHA_CLIENT_KEY=
YANDEX_CAPTCHA_SERVER_KEY=

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------- Sentry (мониторинг ошибок) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Аналитика ----------
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ---------- Прочее ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Added in Phase 1 / plan-01 (FOUND-02) — env Zod parser requirements
# =====================================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_PATH_SECRET=   # 32+ hex chars; generate via `openssl rand -hex 32`
KINESCOPE_PROJECT_ID=
KINESCOPE_PRIVATE_API_TOKEN=
# SMTP_HOST=                     # optional in P1; P2 default uses Supabase SMTP
# YANDEX_CAPTCHA_SERVER_KEY=     # optional in P1; P2 wires SmartCaptcha
# YANDEX_CAPTCHA_CLIENT_KEY surfaces as NEXT_PUBLIC_* below
LOG_LEVEL=info                   # trace|debug|info|warn|error|fatal
# NEXT_PUBLIC_YANDEX_CAPTCHA_CLIENT_KEY=  # optional in P1; P2 wires SmartCaptcha
NEXT_PUBLIC_SITE_URL=http://localhost:3000
